<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="18.0" styleClass="content" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.ClassementController">
   <padding><Insets top="32.0" right="52.0" bottom="32.0" left="52.0"/></padding>

   <VBox spacing="4.0">
      <Label text="Classement" styleClass="page-title"/>
      <Label text="Obtenez le classement par mérite des élèves pour une année scolaire donnée." styleClass="page-description" wrapText="true"/>
   </VBox>

   <HBox spacing="10.0" alignment="CENTER_LEFT">
      <Label text="Année scolaire :" styleClass="form-label"/>
      <TextField fx:id="txtAnnee" promptText="2022-2023" styleClass="search-box" prefWidth="150"/>
      <Button text="Générer classement" onAction="#handleClassement" styleClass="btn, btn-primary"/>
   </HBox>

   <TableView fx:id="tableClassement" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colRang" text="Rang" prefWidth="70"/>
         <TableColumn fx:id="colNom" text="Nom" prefWidth="150"/>
         <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="150"/>
         <TableColumn fx:id="colEcole" text="École" prefWidth="250"/>
         <TableColumn fx:id="colMoyenne" text="Moyenne" prefWidth="100"/>
      </columns>
   </TableView>
</VBox>
