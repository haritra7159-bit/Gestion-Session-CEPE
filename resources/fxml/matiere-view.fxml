<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="18.0" styleClass="content" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.MatiereController">
   <padding><Insets top="32.0" right="52.0" bottom="32.0" left="52.0"/></padding>

   <VBox spacing="4.0">
      <Label text="Gestion des Matières" styleClass="page-title"/>
      <Label text="Définissez les matières et leurs coefficients pour le calcul des moyennes pondérées." styleClass="page-description" wrapText="true"/>
   </VBox>

   <GridPane hgap="14.0" vgap="12.0" styleClass="form-grid">
      <Label text="Numéro :" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
      <TextField fx:id="txtNumMat" promptText="Format valide MAT-XXXX" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
      <Label text="Désignation :" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
      <TextField fx:id="txtDesignMat" promptText="Format valide" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
      <Label text="Coefficient :" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
      <Spinner fx:id="spCoef" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
   </GridPane>

   <HBox spacing="10.0">
      <Button text="Ajouter" onAction="#handleAjouter" styleClass="btn, btn-primary"/>
      <Button text="Modifier" onAction="#handleModifier" styleClass="btn, btn-warning"/>
      <Button text="Supprimer" onAction="#handleSupprimer" styleClass="btn, btn-danger"/>
      <Button text="Réinitialiser" onAction="#handleClear" styleClass="btn, btn-secondary"/>
   </HBox>

   <TableView fx:id="tableMatieres" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colNum" text="Code" prefWidth="100"/>
         <TableColumn fx:id="colDesign" text="Désignation" prefWidth="300"/>
         <TableColumn fx:id="colCoef" text="Coefficient" prefWidth="120"/>
      </columns>
   </TableView>
</VBox>
