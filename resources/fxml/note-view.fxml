<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="18.0" styleClass="content" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.NoteController">
   <padding><Insets top="28.0" right="36.0" bottom="28.0" left="36.0"/></padding>

   <VBox spacing="4.0" styleClass="page-header">
      <Label text="Gestion des Notes" styleClass="page-title"/>
      <Label text="Attribuez, modifiez ou supprimez les notes des élèves par matière et par année scolaire." styleClass="page-description" wrapText="true"/>
   </VBox>

   <GridPane hgap="14.0" vgap="12.0" styleClass="form-grid">
      <Label text="Année :" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
      <TextField fx:id="txtAnnee" promptText="2022-2023" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
      <Label text="Élève :" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
      <ComboBox fx:id="cbEleve" promptText="Choisir un élève" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
      <Label text="Matière :" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
      <ComboBox fx:id="cbMatiere" promptText="Choisir une matière" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
      <Label text="Note :" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
      <TextField fx:id="txtNote" promptText="15.5" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
   </GridPane>

   <HBox spacing="10.0">
      <Button text="Ajouter" onAction="#handleAjouter" styleClass="btn, btn-primary"/>
      <Button text="Modifier" onAction="#handleModifier" styleClass="btn, btn-warning"/>
      <Button text="Supprimer" onAction="#handleSupprimer" styleClass="btn, btn-danger"/>
      <Button text="Réinitialiser" onAction="#handleClear" styleClass="btn, btn-secondary"/>
   </HBox>

   <TableView fx:id="tableNotes" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colAnnee" text="Année" prefWidth="110"/>
         <TableColumn fx:id="colEleve" text="Élève" prefWidth="200"/>
         <TableColumn fx:id="colMatiere" text="Matière" prefWidth="200"/>
         <TableColumn fx:id="colNote" text="Note" prefWidth="100"/>
      </columns>
   </TableView>
</VBox>
