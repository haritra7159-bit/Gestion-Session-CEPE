<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.NoteController">
   <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
   <Label text="Gestion des Notes" styleClass="page-title"><font><Font size="24.0"/></font></Label>
   <GridPane hgap="10" vgap="10">
      <Label text="Année scolaire :" GridPane.rowIndex="0" GridPane.columnIndex="0"/><TextField fx:id="txtAnnee" promptText="2022-2023" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
      <Label text="Élève :" GridPane.rowIndex="0" GridPane.columnIndex="2"/><ComboBox fx:id="cbEleve" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
      <Label text="Matière :" GridPane.rowIndex="1" GridPane.columnIndex="0"/><ComboBox fx:id="cbMatiere" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
      <Label text="Note (/20) :" GridPane.rowIndex="1" GridPane.columnIndex="2"/><TextField fx:id="txtNote" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
   </GridPane>
   <HBox spacing="10">
      <Button text="Ajouter" onAction="#handleAjouter"/><Button text="Modifier" onAction="#handleModifier"/><Button text="Supprimer" onAction="#handleSupprimer"/><Button text="Réinitialiser" onAction="#handleClear"/>
   </HBox>
   <TableView fx:id="tableNotes" VBox.vgrow="ALWAYS">
      <columns><TableColumn fx:id="colAnnee" text="Année" prefWidth="100"/><TableColumn fx:id="colEleve" text="Élève" prefWidth="200"/><TableColumn fx:id="colMatiere" text="Matière" prefWidth="200"/><TableColumn fx:id="colNote" text="Note" prefWidth="100"/></columns>
   </TableView>
</VBox>
