<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.EleveController">
   <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
   <Label text="Gestion des Élèves" styleClass="page-title"><font><Font size="24.0"/></font></Label>
   <GridPane hgap="10" vgap="10">
      <Label text="Numéro :" GridPane.rowIndex="0" GridPane.columnIndex="0"/><TextField fx:id="txtNumEleve" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
      <Label text="École :" GridPane.rowIndex="0" GridPane.columnIndex="2"/><ComboBox fx:id="cbEcole" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
      <Label text="Nom :" GridPane.rowIndex="1" GridPane.columnIndex="0"/><TextField fx:id="txtNom" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
      <Label text="Prénom :" GridPane.rowIndex="1" GridPane.columnIndex="2"/><TextField fx:id="txtPrenom" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
      <Label text="Date naissance :" GridPane.rowIndex="2" GridPane.columnIndex="0"/><DatePicker fx:id="dpNaissance" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
   </GridPane>
   <HBox spacing="10">
      <Button text="Ajouter" onAction="#handleAjouter"/><Button text="Modifier" onAction="#handleModifier"/><Button text="Supprimer" onAction="#handleSupprimer"/><Button text="Réinitialiser" onAction="#handleClear"/>
   </HBox>
   <TableView fx:id="tableEleves" VBox.vgrow="ALWAYS">
      <columns><TableColumn fx:id="colNum" text="Numéro" prefWidth="80"/><TableColumn fx:id="colNom" text="Nom" prefWidth="120"/><TableColumn fx:id="colPrenom" text="Prénom" prefWidth="120"/><TableColumn fx:id="colEcole" text="École" prefWidth="200"/><TableColumn fx:id="colNaissance" text="Date naissance" prefWidth="120"/></columns>
   </TableView>
</VBox>
