<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="mainContainer" prefHeight="800.0" prefWidth="1280.0" styleClass="root-layout" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.MainController">
   <padding><Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/></padding>
   <center>
      <HBox spacing="16.0">
         <!-- Sidebar : min/pref/max width identiques = impossible à compresser -->
         <VBox styleClass="sidebar" spacing="6.0" minWidth="260" prefWidth="260" maxWidth="260">
            <padding><Insets bottom="24.0" left="18.0" right="18.0" top="24.0"/></padding>
            <Label styleClass="brand" text="Gestion du" maxWidth="Infinity" />
            <Label styleClass="brand-accent" text="CEPE" maxWidth="Infinity" />
            <Label styleClass="subtitle" text="Session &amp; Résultats" maxWidth="Infinity" wrapText="true" />
            <Button fx:id="btnAccueil" styleClass="nav-button" text="🏠 Accueil" maxWidth="Infinity" />
            <Button fx:id="btnEcoles" styleClass="nav-button" text="🏫 Écoles" maxWidth="Infinity" />
            <Button fx:id="btnEleves" styleClass="nav-button" text="🎓 Élèves" maxWidth="Infinity" />
            <Button fx:id="btnMatieres" styleClass="nav-button" text="📚 Matières" maxWidth="Infinity" />
            <Button fx:id="btnDeliberation" styleClass="nav-button" text="⚖️ Délibération" maxWidth="Infinity" />
            <Button fx:id="btnClassement" styleClass="nav-button" text="🏆 Classement" maxWidth="Infinity" />
         </VBox>

         <!-- Contenu principal -->
         <StackPane fx:id="contentContainer" styleClass="content-wrapper" HBox.hgrow="ALWAYS"/>
      </HBox>
   </center>
</BorderPane>