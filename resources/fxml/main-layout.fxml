<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="mainContainer" prefHeight="760.0" prefWidth="1200.0" styleClass="root-layout" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.MainController">
   <left>
      <VBox styleClass="sidebar" spacing="5.0">
         <padding><Insets bottom="20.0" left="15.0" right="15.0" top="20.0"/></padding>
         <Label styleClass="brand" text="Geestion du CEPE" />
         <Label styleClass="subtitle" text="Gestion de session" />
         <Button fx:id="btnEcoles" styleClass="nav-button" text="🏫 Écoles" maxWidth="Infinity" />
         <Button fx:id="btnEleves" styleClass="nav-button" text="🎓 Élèves" maxWidth="Infinity" />
         <Button fx:id="btnMatieres" styleClass="nav-button" text="📚 Matières" maxWidth="Infinity" />
         <Button fx:id="btnNotes" styleClass="nav-button" text="📝 Notes" maxWidth="Infinity" />
         <Button fx:id="btnDeliberation" styleClass="nav-button" text="⚖️ Délibération" maxWidth="Infinity" />
         <Button fx:id="btnClassement" styleClass="nav-button" text="🏆 Classement" maxWidth="Infinity" />
         <Button fx:id="btnRecherche" styleClass="nav-button" text="🔍 Recherche" maxWidth="Infinity" />
         <Button fx:id="btnReleve" styleClass="nav-button" text="📄 Relevé PDF" maxWidth="Infinity" />
      </VBox>
   </left>
   <center>
      <VBox alignment="CENTER" styleClass="content" spacing="10">
         <Label styleClass="page-title" text="Bienvenue" />
         <Label styleClass="page-description" text="Sélectionnez une section dans le menu de gauche." />
      </VBox>
   </center>
</BorderPane>
