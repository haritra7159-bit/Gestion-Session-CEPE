<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="mainContainer" prefHeight="800.0" prefWidth="1280.0" styleClass="root-layout" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.MainController">
   <left>
      <VBox styleClass="sidebar" spacing="6.0">
         <padding><Insets bottom="24.0" left="18.0" right="18.0" top="24.0"/></padding>
         <Label styleClass="brand" text="Gestion du " />
         <Label styleClass="brand-accent" text="CEPE" />
         <Label styleClass="subtitle" text="Session &amp; Résultats" />
         <Button fx:id="btnAccueil" styleClass="nav-button" text="🏠 Accueil" maxWidth="Infinity" />
         <Button fx:id="btnEcoles" styleClass="nav-button" text="🏫 Écoles" maxWidth="Infinity" />
         <Button fx:id="btnEleves" styleClass="nav-button" text="🎓 Élèves" maxWidth="Infinity" />
         <Button fx:id="btnMatieres" styleClass="nav-button" text="📚 Matières" maxWidth="Infinity" />
         <Button fx:id="btnDeliberation" styleClass="nav-button" text="⚖️ Délibération" maxWidth="Infinity" />
         <Button fx:id="btnClassement" styleClass="nav-button" text="🏆 Classement" maxWidth="Infinity" />
      </VBox>
   </left>
</BorderPane>