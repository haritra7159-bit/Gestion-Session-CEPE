<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="16.0" styleClass="dialog-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.EleveNotesDialogController">
   <padding><Insets top="24.0" right="28.0" bottom="24.0" left="28.0"/></padding>

   <Label fx:id="lblTitre" text="Notes de l'élève" styleClass="dialog-title"/>

   <GridPane hgap="12.0" vgap="10.0" styleClass="form-grid">
      <Label text="Année scolaire :" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
      <TextField fx:id="txtAnnee" promptText="AAAA-AAAA" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
      <Label text="Matière :" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
      <ComboBox fx:id="cbMatiere" promptText="Choisir une matière" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
      <Label text="Note (/20) :" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
      <TextField fx:id="txtNote" promptText="15.5" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
   </GridPane>

   <HBox spacing="10.0">
      <Button text="Ajouter" onAction="#handleAjouter" styleClass="btn, btn-primary"/>
      <Button text="Modifier" onAction="#handleModifier" styleClass="btn, btn-warning"/>
      <Button text="Supprimer" onAction="#handleSupprimer" styleClass="btn, btn-danger"/>
      <Button text="Réinitialiser" onAction="#handleClear" styleClass="btn, btn-secondary"/>
   </HBox>

   <TableView fx:id="tableNotes" VBox.vgrow="ALWAYS" prefHeight="280.0">
      <columns>
         <TableColumn fx:id="colAnnee" text="Année" prefWidth="110"/>
         <TableColumn fx:id="colMatiere" text="Matière" prefWidth="220"/>
         <TableColumn fx:id="colNote" text="Note" prefWidth="100"/>
      </columns>
   </TableView>

   <HBox spacing="12.0" alignment="CENTER_RIGHT">
      <Button text="📄 Générer Relevé" onAction="#handleGenererReleve" styleClass="btn, btn-success"/>
      <Button text="Fermer" onAction="#handleFermer" styleClass="btn, btn-secondary"/>
   </HBox>
</VBox>
