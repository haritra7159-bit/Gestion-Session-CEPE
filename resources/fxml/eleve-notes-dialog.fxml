<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18.0" styleClass="dialog-root, content" prefWidth="1120.0" prefHeight="620.0"
   xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="mg.cepe.gestion.controller.EleveNotesDialogController">
   <padding>
      <Insets top="24.0" right="28.0" bottom="24.0" left="28.0" />
   </padding>

   <HBox alignment="CENTER_LEFT" spacing="20.0">
      <Label fx:id="lblTitre" text="Notes de l'élève" styleClass="dialog-title" />
      <Region HBox.hgrow="ALWAYS" />
      <HBox alignment="CENTER" spacing="10.0">
         <Label text="Année scolaire :" styleClass="form-label" />
         <ComboBox fx:id="cbAnnee" editable="true" promptText="AAAA-AAAA" prefWidth="160" />
      </HBox>
   </HBox>

   <HBox spacing="20.0" VBox.vgrow="ALWAYS">
      <VBox HBox.hgrow="ALWAYS" spacing="10.0">
         <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="cards-scroll-pane">
            <content>
               <TilePane fx:id="gridMatieres" hgap="14.0" vgap="14.0" prefColumns="2"
                  styleClass="cards-grid" />
            </content>
         </ScrollPane>
      </VBox>

      <fx:include fx:id="relevePreview" source="RelevePreviewPane.fxml" />
   </HBox>

   <HBox spacing="12.0" alignment="CENTER_RIGHT">
      <Button fx:id="btnReleve" text="📄 Générer Relevé PDF" onAction="#handleGenererReleve"
         styleClass="btn, btn-success" />
      <Button text="Fermer" onAction="#handleFermer" styleClass="btn, btn-secondary" />
   </HBox>
</VBox>