<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.ReleveController">
   <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
   <Label text="Relevé de notes PDF" styleClass="page-title"><font><Font size="24.0"/></font></Label>
   <GridPane hgap="10" vgap="10">
      <Label text="Année scolaire :" GridPane.rowIndex="0" GridPane.columnIndex="0"/><TextField fx:id="txtAnnee" promptText="2022-2023" text="2022-2023" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
      <Label text="Élève :" GridPane.rowIndex="1" GridPane.columnIndex="0"/><ComboBox fx:id="cbEleve" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
   </GridPane>
   <Button text="Générer le relevé PDF" onAction="#handleGenerer"/>
   <Label fx:id="lblStatus" text="" textFill="green"/>
</VBox>
