<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="18.0" styleClass="content" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.ReleveController">
   <padding><Insets top="28.0" right="36.0" bottom="28.0" left="36.0"/></padding>

   <VBox spacing="4.0" styleClass="page-header">
      <Label text="Relevé de Notes PDF" styleClass="page-title"/>
      <Label text="Sélectionnez un élève et une année scolaire pour générer son relevé de notes au format PDF." styleClass="page-description" wrapText="true"/>
   </VBox>

   <GridPane hgap="14.0" vgap="12.0" styleClass="form-grid">
      <Label text="Année scolaire :" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
      <TextField fx:id="txtAnnee" promptText="AAAA-AAAA" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
      <Label text="Élève :" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
      <ComboBox fx:id="cbEleve" promptText="Choisir un élève" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
   </GridPane>

   <HBox spacing="10.0">
      <Button text="Générer PDF" onAction="#handleGenerer" styleClass="btn, btn-primary"/>
   </HBox>

   <Label fx:id="lblStatus" text="" styleClass="page-description"/>
</VBox>
