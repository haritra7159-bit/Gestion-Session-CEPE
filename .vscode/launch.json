{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Déboguer CEPE (JavaFX)",
      "request": "launch",
      "mainClass": "mg.cepe.gestion.Main",
      "projectName": "gestion-session-cepe",
      "vmArgs": [
        "--module-path",
        "${env:USERPROFILE}\\.m2\\repository\\org\\openjfx\\javafx-base\\25.0.4\\javafx-base-25.0.4-win.jar;${env:USERPROFILE}\\.m2\\repository\\org\\openjfx\\javafx-graphics\\25.0.4\\javafx-graphics-25.0.4-win.jar;${env:USERPROFILE}\\.m2\\repository\\org\\openjfx\\javafx-controls\\25.0.4\\javafx-controls-25.0.4-win.jar;${env:USERPROFILE}\\.m2\\repository\\org\\openjfx\\javafx-fxml\\25.0.4\\javafx-fxml-25.0.4-win.jar",
        "--add-modules",
        "javafx.controls,javafx.fxml",
        "-Dprism.order=sw"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
