<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.cepe.gestion.controller.MainController" styleClass="root-layout">
    <left><VBox spacing="8" styleClass="sidebar"><padding><Insets top="24" right="18" bottom="24" left="18"/></padding>
        <Label text="CEPE" styleClass="brand"/><Label text="Session scolaire" styleClass="subtitle"/>
        <Button text="🏫  Écoles" onAction="#showComingSoon" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="👨  Élèves" onAction="#showComingSoon" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="📘  Matières" onAction="#showComingSoon" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="📝  Notes" onAction="#showComingSoon" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="📊  Délibération" onAction="#showComingSoon" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="📄  Relevé PDF" onAction="#showComingSoon" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="🏆  Classement" onAction="#showComingSoon" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="⚙  Paramètres" onAction="#showComingSoon" maxWidth="Infinity" styleClass="nav-button"/>
    </VBox></left>
    <center><VBox spacing="12" styleClass="content"><padding><Insets top="42" right="48" bottom="42" left="48"/></padding>
        <Label fx:id="pageTitle" text="Bienvenue dans la gestion CEPE" styleClass="page-title"/>
        <Label text="Le socle applicatif est prêt. Les modules métier seront ajoutés progressivement." styleClass="page-description"/>
    </VBox></center>
</BorderPane>
